# Real-hardware photo test over JTAG -- the hardware-side counterpart to
# the simulation-only feature_bram_stage/copy_fsm_1 path (C3 investigation,
# 2026-10-29). NOT YET RUN AGAINST REAL HARDWARE: written and address-mapped
# from the actual build's own ADDR_SEG output (see below), but this
# environment has no Genesys 2 / JTAG cable attached to verify it against.
# Review before first use; treat the first run as a real test of this
# script too, not just of the board.
#
# Why JTAG instead of reusing copy_fsm/feature_bram_stage on real hardware:
# that path is synthesis-time $readmemh into BRAM -- one baked-in photo per
# bitstream, a full rebuild to change it. jtag_axi_0 ("keep this permanently
# as a debug tool", SESSION_HANDOFF_20261028.md) can write arbitrary DDR
# content and poke cnn_engine's AXI-Lite control register directly, with no
# resynthesis per photo.
#
# Address map (from this project's own `assign_bd_address` output --
# docs/PHASE2_LOG.md / ADDR_SEG lines -- not assumed):
#   jtag_axi_0 -> cnn_engine_0/s_axi_control : local offset 0x00000000, range 0x1000
#   jtag_axi_0 -> mig_7series_0 DDR window    : local offset 0x80000000, range 0x40000000
# cnn_engine_0's AXI-Lite register map (rtl/cnn_core/cnn_engine_control_s_axi.v):
#   ADDR_AP_CTRL            = 0x00  (bit0=ap_start, bit1=ap_done, bit2=ap_idle, bit3=ap_ready)
#   ADDR_FEATURES_DATA_0/1  = 0x10 / 0x14
#   ADDR_COEFFICIENTS_DATA_0/1 = 0x1c / 0x20
# FEATURE_BASE_ADDR = 0x80000000, COEFFICIENT_BASE_ADDR = 0x80300000 (same
# constants ap_start_seq.v/copy_fsm.v use -- single shared global AXI map,
# jtag_axi_0 sees the identical addresses).
#
# Flow: program the bitstream, let the automatic boot sequence run once
# (calibration -> coeff copy -> ap_start_seq's first pass against whatever
# feature memory happens to hold -- a throwaway pass, same as the sim's
# known 374-cycle finding; we don't care about its result), THEN burst-write
# the real photo into the feature region and manually re-trigger ap_start
# via direct control-register writes (bypassing ap_start_seq for this
# second, real-data pass), then poll ADDR_AP_CTRL until ap_done.
#
# Usage: vivado -mode batch -source scripts/jtag_photo_test.tcl \
#            -tclargs <bitstream.bit> <feature_lanes32.hex>
# (feature_lanes32.hex from: python3 scripts/pack_image_to_hex.py <img> <out> --format lanes32)

if {[llength $argv] < 2} {
    puts "Usage: jtag_photo_test.tcl <bitstream.bit> <feature_lanes32.hex>"
    exit 1
}
set bitstream [lindex $argv 0]
set lanes_file [lindex $argv 1]
# Same directory, .ltx instead of .bit -- generated by
# scripts/program.tcl (or write_debug_probes directly) alongside the
# bitstream. Required for jtag_axi_0 to enumerate as a hw_axi object; a
# missing .ltx manifests as "No matching hw_axi were found" even though the
# debug hub and AXI debug core are both actually present in the bitstream
# (found by actually running this script, not by inspection).
set probes_file [file rootname $bitstream].ltx
if {![file exists $probes_file]} {
    puts "ERROR: no .ltx at $probes_file -- run scripts/program.tcl first (it generates this), or write_debug_probes manually."
    exit 1
}

set FEATURE_BASE_ADDR       0x80000000
set COEFFICIENT_BASE_ADDR   0x80300000
set ADDR_AP_CTRL            0x00
set ADDR_FEATURES_DATA_0    0x10
set ADDR_FEATURES_DATA_1    0x14
set ADDR_COEFFICIENTS_DATA_0 0x1c
set ADDR_COEFFICIENTS_DATA_1 0x20

open_hw_manager
connect_hw_server
open_hw_target
set dev [lindex [get_hw_devices] 0]
puts "Target device: $dev"
if {![string match "xc7k325t*" $dev]} {
    puts "WARNING: expected an xc7k325t device, found $dev -- check the board/cable before continuing."
}

set_property PROGRAM.FILE $bitstream $dev
set_property PROBES.FILE $probes_file $dev
program_hw_devices $dev

# The debug hub (dbg_hub) needs its clock (mig_7series_0/ui_clk, since
# jtag_axi_0's aclk drives it) free-running and stable before XSDB can scan
# it -- immediately after configuration, MIG's MMCM/calibration sequence is
# still settling. Observed flaky in practice: one run found the AXI debug
# core immediately, the very next (otherwise identical) run failed with
# "debug hub core was not detected" -- a race, not a real missing-hub
# problem (the hub IS in the bitstream, confirmed in synth_1/runme.log).
# Retry refresh a few times with a settle delay rather than failing on the
# first miss.
set axi_core ""
for {set attempt 1} {$attempt <= 5} {incr attempt} {
    after 2000
    refresh_hw_device -update_hw_probes true $dev
    set axi_core [lindex [get_hw_axis -of_objects $dev -quiet] 0]
    if {$axi_core ne ""} break
    puts "Debug hub/hw_axi not found yet (attempt $attempt/5), retrying..."
}
if {$axi_core eq ""} {
    puts "ERROR: no hw_axi (jtag_axi) core found after 5 refresh attempts -- bitstream may not match this script's address map, or the debug hub genuinely didn't come up."
    exit 1
}
puts "AXI debug core: $axi_core"

proc axi_write1 {core addr data} {
    create_hw_axi_txn -force t_w $core -address $addr -data [format %08x $data] -len 1 -type write
    run_hw_axi [get_hw_axi_txns t_w]
}
proc axi_read1 {core addr} {
    create_hw_axi_txn -force t_r $core -address $addr -len 1 -type read
    run_hw_axi [get_hw_axi_txns t_r]
    set result [get_property DATA [get_hw_axi_txns t_r]]
    # DATA comes back as a single underscore-joined string even for len=1
    # (found by actually running this, not by inspection -- the first
    # version assumed a Tcl list and `lindex`'d it, which silently returned
    # the whole string unmodified since Tcl only splits on whitespace).
    # Strip any underscores/whitespace and make it an explicit 0x-prefixed
    # hex literal so `expr` parses it as a number instead of erroring with
    # "can't use non-numeric string as operand".
    set clean [string trim [lindex [split $result "_"] 0]]
    if {![scan $clean %x value]} {
        puts "axi_read1: could not parse DATA property as hex -- raw value was: '$result'"
        set value 0
    }
    return $value
}
# Burst write up to 256 beats per transaction (AXI4 AWLEN max), looping for
# longer payloads. `words` is a Tcl list of 32-bit hex strings (no 0x
# prefix), in ascending-address order.
proc axi_write_burst {core base_addr words} {
    set n [llength $words]
    set i 0
    while {$i < $n} {
        set chunk_len [expr {min(256, $n - $i)}]
        set chunk [lrange $words $i [expr {$i + $chunk_len - 1}]]
        set data_str [join $chunk "_"]
        set addr [format "0x%016x" [expr {$base_addr + 4 * $i}]]
        create_hw_axi_txn -force t_wb $core -address $addr -data $data_str -len $chunk_len -type write
        run_hw_axi [get_hw_axi_txns t_wb]
        incr i $chunk_len
    }
    puts "wrote $n words (32-bit) starting at [format 0x%016x $base_addr]"
}

# Let the automatic boot sequence (calibration -> coeff copy -> ap_start_seq's
# first, throwaway pass) settle. No board-side signal is polled here (the
# only observability besides this JTAG core is the UART status byte) --
# this is a flat delay, generous relative to the sim-measured calibration +
# 256-word coefficient copy time. Real coefficient count is 41,600 words at
# full hardware AXI speed (not the sim's one-transaction-per-word model
# over a slow behavioral DDR3 timing model) -- expected to be well under a
# second, but 5s leaves real margin for a first, unverified run.
puts "Waiting 5s for automatic boot sequence (calibration + coefficient copy + throwaway ap_start pass)..."
after 5000

# Load the real photo into feature memory.
set fh [open $lanes_file r]
set lane_words [split [string trim [read $fh]] "\n"]
close $fh
puts "Loaded [llength $lane_words] feature lanes from $lanes_file"
axi_write_burst $axi_core $FEATURE_BASE_ADDR $lane_words

# BUG FOUND AND FIXED (2026-10-29, diagnosing the apparent real-hardware C3
# repro): ap_done on cnn_engine's AXI-Lite control register is read-to-clear
# (standard Xilinx HLS ap_ctrl_hs semantics). The automatic boot-time
# ap_start_seq_0 pass already latched ap_done=1 well before this script
# ever reads the register -- the first version of this script never read
# (and thus never cleared) that stale bit before polling for ITS OWN
# trigger's completion, so "ap_done observed after 0 poll iterations" was
# reading leftover state from the automatic pass, not reflecting this
# script's trigger at all. Confirmed directly: reading AP_CTRL once here
# clears a stale 0x0e down to 0x04 (done bit drops), and a properly-cleared
# trigger measures ~64ms wall-clock to done -- above the ~37.7ms real-pass
# floor, not an instant/fake completion.
set stale [axi_read1 $axi_core $ADDR_AP_CTRL]
puts [format "Cleared stale AP_CTRL (read-to-clear) = 0x%08x" $stale]

# Manually re-trigger ap_start against the now-real feature data (bypasses
# ap_start_seq_0, which already fired once automatically against whatever
# was in feature memory before this write -- same 5-write sequence it does,
# done here by hand so this second pass is deliberately against real data).
axi_write1 $axi_core $ADDR_FEATURES_DATA_0 $FEATURE_BASE_ADDR
axi_write1 $axi_core $ADDR_FEATURES_DATA_1 0
axi_write1 $axi_core $ADDR_COEFFICIENTS_DATA_0 $COEFFICIENT_BASE_ADDR
axi_write1 $axi_core $ADDR_COEFFICIENTS_DATA_1 0
set t_start [clock milliseconds]
axi_write1 $axi_core $ADDR_AP_CTRL 0x00000001
set t_after_write [clock milliseconds]
puts "ap_start issued (manual, real feature data). AP_CTRL write took [expr {$t_after_write - $t_start}]ms."

# Poll ap_done (bit1 of AP_CTRL). No hardware cycle counter exists yet
# (future work, see docs/PHASE2_LOG.md) -- the poll-iteration count below is
# a very rough proxy only (dominated by JTAG round-trip latency, not
# cnn_engine's actual cycle count), useful mainly to distinguish "instant"
# from "took a while", not to reproduce Phase 1's precise cycle figures.
set max_polls 2000
set polls 0
set done 0
set t_first_read_start [clock milliseconds]
while {$polls < $max_polls} {
    set ctrl [axi_read1 $axi_core $ADDR_AP_CTRL]
    if {$polls == 0} {
        set t_first_read_done [clock milliseconds]
    }
    if {[expr {$ctrl & 0x2}] != 0} {
        set done 1
        break
    }
    incr polls
}
set t_end [clock milliseconds]
if {!$done} {
    puts "TIMEOUT: ap_done not observed after $max_polls polls. AP_CTRL last read: [format 0x%08x $ctrl]"
    exit 1
}
set wall_write_to_done_ms [expr {$t_end - $t_after_write}]
set wall_single_read_ms [expr {$t_first_read_done - $t_first_read_start}]
puts "ap_done observed after $polls poll iterations."
puts "WALL CLOCK: ap_start write -> ap_done confirmed = ${wall_write_to_done_ms}ms. A single bare AXI read transaction alone took ${wall_single_read_ms}ms."
puts "For reference: a REAL full compute pass is ~3,774,628 cycles (Phase 1) at cnn_engine's new 100MHz clock = ~37.7ms minimum. If wall_write_to_done_ms is well under that even accounting for the single-read baseline above, this is almost certainly the same instant/fake-done pattern as the simulation's 374-cycle finding, not a genuine completed pass -- interpret accordingly."

# Coarse sanity readback: first few 32-bit lanes at each head's offset.
# HEAD0_OFFSET=18432, HEAD1_OFFSET=0 (256-bit/32-byte words -- from this
# project's own cnn_hls_work/program.h, not the sim-bypass build's, which
# cuts coefficient count but does NOT change head offsets). These are RAW
# Q14 lane values (divide by 16384.0 for the float), not a decoded
# detection (channel/anchor layout within each 21-channel head needs
# program.json's exact BHWC packing to decode fully -- this is a presence/
# sanity check, not a decoder).
set HEAD0_BYTE_OFFSET [expr {$FEATURE_BASE_ADDR + 18432 * 32}]
set HEAD1_BYTE_OFFSET [expr {$FEATURE_BASE_ADDR + 0 * 32}]
puts "--- HEAD1 (offset 0), first 16 raw lanes ---"
for {set i 0} {$i < 16} {incr i} {
    set addr [format "0x%016x" [expr {$HEAD1_BYTE_OFFSET + 4*$i}]]
    set v [axi_read1 $axi_core $addr]
    set signed_v $v
    if {$v > 0x7fffffff} { set signed_v [expr {$v - 0x100000000}] }
    puts [format "  lane %2d: raw=0x%08x  Q14=%0.4f" $i $v [expr {$signed_v / 16384.0}]]
}
puts "--- HEAD0 (offset 18432 words), first 16 raw lanes ---"
for {set i 0} {$i < 16} {incr i} {
    set addr [format "0x%016x" [expr {$HEAD0_BYTE_OFFSET + 4*$i}]]
    set v [axi_read1 $axi_core $addr]
    set signed_v $v
    if {$v > 0x7fffffff} { set signed_v [expr {$v - 0x100000000}] }
    puts [format "  lane %2d: raw=0x%08x  Q14=%0.4f" $i $v [expr {$signed_v / 16384.0}]]
}
