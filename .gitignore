# Generated builds and local captures stay on this machine.
**/__pycache__/
*.py[cod]
.venv*/
**/.Xil/
**/.cache/
build/
builds/
local_results/
local_artifacts/
*.bit
*.dcp
*.zip
*.jou
*.log
*.str
*.wdb
*.vcd
*.vvp
*.xpr
*.xsa
**/*.runs/
**/*.cache/
**/*.gen/
**/*.hw/
**/*.ip_user_files/
*.mp4
*.mov
*.avi
*.png
*.jpg
*.jpeg
*.pdf
*.yuyv.bin
*.rgb.bin
*.rgb565.bin
*.yuv.bin
cnn/checks/
cnn/evidence/baseline_report/model/
camera/working/SHA256_MANIFEST.json
camera/working/ARCHIVE_STATUS.json
camera/working/RESTORE_BEST.ps1
# Secrets must never be staged.
.env
.env.*
!.env.example
*.pem
*.key

# Shipped bitstreams are the one exception to the *.bit rule above.
!bitstreams/**/*.bit
